#!/bin/bash
#$ -S /bin/bash
#$ -cwd
#$ -N LLRP_fin
#$ -o logs/
#$ -e logs/
# Closes one stage after all of its arms (qsub -hold_jid <array job id>): hpc/finalize.sh with OUT and ARMS from `-v STAGE_ENV=<stage folder>/stage.env`.
# On a problem the job ends with exit code 100: SGE puts it into the error state (Eqw), so the jobs held on it (the next stage) are NOT released.
# After repairing the stage (resubmit the missing arms, wait until they are done) `qmod -cj <finalize job id>` runs the finalize job again; if it passes,
# the next stage is released. The next stage's arms also check for <previous stage>/FINALIZE_OK themselves (REQUIRE_OK gate), whatever the scheduler does.
set -u
if [ -n "${STAGE_ENV:-}" ]; then
    [ -f "$STAGE_ENV" ] || { echo "ERROR: STAGE_ENV file not found: $STAGE_ENV"; exit 100; }
    . "$STAGE_ENV" || exit 100
fi
export OUT ARMS
bash hpc/finalize.sh
rc=$?
[ "$rc" -eq 0 ] || exit 100
