#!/bin/bash
# irace target-runner for llrp_fast (generated by `llrp_tools irace-gen`).
#   irace calls:  target-runner <config-id> <instance-id> <seed> <instance-file> <--switch value> ...
#   prints ONE number: cost = 100*(latency - BKS)/BKS  [% gap to the reference BKS, lower = better];
#   infeasible result / empty operator pool -> PENALTY.
# Budget of every run (override with environment variables):
#   IRACE_MODE=time : CPU-time limit  = max(TMIN, TC * n / 100) seconds  (equal-CPU comparison; a cheap pool can run more iterations)
#   IRACE_MODE=iter : fixed number of GRASP iterations ITERS             (equal-iteration comparison; favours the largest pool)
HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/.." && pwd)
BIN=${BIN:-$ROOT/bin/llrp_fast}
MODE=${IRACE_MODE:-time}; TC=${TC:-30}; TMIN=${TMIN:-5}; ITERS=${ITERS:-150}; PENALTY=${PENALTY:-1000}
CID=$1; IID=$2; SEED=$3; INST=$4; shift 4
ops=(); extra=(); so=0; ils_on=0; ils_k=20
while [ $# -ge 2 ]; do
  case "$1" in
    --op-*)   [ "$2" = "1" ] && ops+=("${1#--op-}");;
    --so-on)  so=$2;;
    --ils-on) ils_on=$2;;
    --ils)    ils_k=$2;;
    *)        extra+=("$1" "$2");;
  esac
  shift 2
done
[ "$ils_on" = 1 ] && extra+=(--ils "$ils_k")
if [ ${#ops[@]} -eq 0 ]; then echo "$PENALTY"; exit 0; fi
OPS=$(IFS=,; echo "${ops[*]}")
FLAGS=(--ops "$OPS")
[ "$so" = 1 ] && FLAGS+=(--so)
read -r n bks < <(awk '$1=="n"{n=$2} $1=="bks"{b=$2} /^depots/{print n, b; exit}' "$INST")
[ -n "$n" ] && [ -n "$bks" ] || { echo "target-runner: cannot read n/bks from $INST" >&2; exit 1; }
if [ "$MODE" = iter ]; then BUD=(--max-iter "$ITERS")
else TL=$(awk -v tc="$TC" -v n="$n" -v tm="$TMIN" 'BEGIN{t=tc*n/100; if(t<tm)t=tm; printf "%.3f", t}'); BUD=(--time "$TL" --max-iter 100000); fi
out=$("$BIN" --instance "$INST" --seed "$SEED" "${FLAGS[@]}" "${extra[@]}" "${BUD[@]}" --quiet 2>/dev/null) || { echo "target-runner: llrp_fast failed (config $CID, $INST)" >&2; exit 1; }
cost=$(echo "$out" | awk -v b="$bks" -v pen="$PENALTY" '$1=="final_cost"{c=$2} $1=="feasible"{f=$2} END{ if (f==1 && b>0) printf "%.6f", 100*(c-b)/b; else printf "%s", pen }')
if [ -n "${TRLOG:-}" ]; then echo "$CID $IID $SEED $INST $cost $(echo "$out" | awk '$1=="cpu_s"{c=$2} $1=="iterations"{i=$2} END{print c, i}')" >> "$TRLOG"; fi
echo "$cost"
